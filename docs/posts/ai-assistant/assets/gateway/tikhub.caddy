tikhub-proxy.liuhetian.work {
	@authorized header Authorization "Bearer {$TIKHUB_GATEWAY_TOKEN}"
	log_append vendor tikhub

	handle @authorized {
		log_append caller personal
		log_append authenticated true
		reverse_proxy https://api.tikhub.io {
			header_up Authorization "Bearer {$TIKHUB_API_KEY}"
			header_up -Proxy-Authorization
		}
	}

	handle {
		log_append caller unauthenticated
		log_append authenticated false
		header Content-Type application/json
		header WWW-Authenticate Bearer
		respond `{"error":{"message":"A valid gateway token is required.","type":"authentication_error"}}` 401
	}

	log tikhub_proxy {
		output file /var/log/caddy/tikhub-proxy/access.json {
			roll_size 10MiB
			roll_keep 30
			roll_keep_for 2160h
		}
		format filter {
			wrap json
			fields {
				request delete
				resp_headers delete
				duration delete
				size delete
				bytes_read delete
				user_id delete
			}
		}
	}
}
